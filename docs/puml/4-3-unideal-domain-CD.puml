' ==============================================================================
' 4-3-unideal-domain-CD.puml
'
' Svrha:    Prikazuje domenske razrede Offer i Partner, servise OfferService i
'           PartnerService te sučelja repozitorija kojima je trajna pohrana
'           apstrahirana. Servisi primaju repozitorije kroz konstruktor.
' Kod:      src/domain, src/services, src/repositories
'
' Diagram level: Structural / Domain Design
' Diagram type:  Class Diagram
' ==============================================================================

@startuml
!pragma layout smetana
title UniDeal – domenski model ponuda i partnera

skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor #212529

skinparam class {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

package "Aplikacijski sloj" {
    class OfferService {
        +search(filter: OfferFilter): OfferListing[]
        +getActiveOffer(id: String): OfferListing
        +getPartnerOffers(partnerId: String): Offer[]
        +getOwnOffer(ownerId: String, offerId: String): Offer
        +createOffer(ownerId: String, data: OfferInput, photo: File): OfferErrors
        +updateOffer(ownerId: String, offerId: String, data: OfferInput, photo: File): OfferErrors
        +deleteOffer(ownerId: String, offerId: String): Boolean
    }
    class PartnerService {
        +getAll(): Partner[]
        +getByOwner(ownerId: String): Partner
        +getCities(): String[]
        +getProfile(id: String): Profile
    }
}

package "Domenski sloj" {
    enum OfferStatus {
        nacrt
        aktivna
        istekla
    }
    enum DiscountType {
        postotak
        iznos
    }
    class Offer {
        +id: String
        +title: String
        +description: String
        +category: String
        +categoryId: String
        +discountType: DiscountType
        +discountValue: Number
        +validUntil: String
        +conditions: String
        +status: OfferStatus
        +photoUrl: String
        +isActive(): Boolean
        +canBeActivated(): Boolean
        +canBeEdited(): Boolean
        +discountLabel: String
    }
    class Partner {
        +id: String
        +name: String
        +category: String
        +city: String
        +address: String
        +hours: String
    }
    interface OfferRepository {
        +findAll(): Offer[]
        +findById(id: String): Offer
        +findByPartner(partnerId: String): Offer[]
        +create(partnerId: String, data: OfferInput): String
        +update(id: String, data: OfferInput): void
        +setPhoto(id: String, photoUrl: String): void
        +delete(id: String): void
    }
    interface PartnerRepository {
        +findAll(): Partner[]
        +findById(id: String): Partner
        +findByOwner(ownerId: String): Partner
    }
    interface CategoryRepository {
        +findAll(): Category[]
    }
}

package "Infrastruktura" {
    class SupabaseOfferRepository
    class SupabasePartnerRepository
}

Partner "1" -- "0..*" Offer : objavljuje >
Offer --> OfferStatus
Offer --> DiscountType

OfferService --> OfferRepository
OfferService --> PartnerRepository
OfferService --> CategoryRepository
PartnerService --> PartnerRepository
PartnerService --> OfferRepository

SupabaseOfferRepository ..|> OfferRepository
SupabasePartnerRepository ..|> PartnerRepository

@enduml
