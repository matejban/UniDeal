' ==============================================================================
' 3-1-unideal-pregled-UC.puml
'
' Svrha:    Pregledni dijagram: granica sustava, akteri i glavne skupine ciljeva.
'           Svaka skupina detaljnije je prikazana na jednom od usmjerenih
'           dijagrama (Slike 3.2 – 3.5). Vanjski sustavi prikazani su tamo.
' Autor:    Elide Babić
' AI:       Nacrt je izrađen uz pomoć alata Claude prema uputama autorice;
'           autorica ga je iscrtala, provjerila prema specifikacijama u 3.2 i
'           odgovara za sadržaj.
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
' Smjer veza (predavanja, slajd 24): aktivni akter -> obrazac, obrazac -> pasivni akter.
title UniDeal – pregled obrazaca uporabe (Slika 3.1)
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

actor "Posjetitelj" as Visitor
actor "Student" as Student
actor "Partner" as Partner
actor "Administrator" as Admin

rectangle "Sustav UniDeal" {
    usecase "Prijava i profil\nUC-1.1 – UC-1.4\n(Slika 3.2)" as G1
    usecase "Pretraga ponuda i partnera\nUC-2.3, UC-4.1, UC-4.2\n(Slika 3.3, 3.4)" as G2
    usecase "Kuponi, favoriti i ocjene\nUC-2.4, UC-4.4, UC-5.1, UC-5.3, UC-5.4\n(Slika 3.4)" as G3
    usecase "Profil partnera i ponude\nUC-2.1, UC-2.2, UC-3.1, UC-3.2, UC-4.3\n(Slika 3.3)" as G4
    usecase "Potvrda kupona\nUC-5.2\n(Slika 3.4)" as G5
    usecase "Pretplata partnera\nUC-6.1, UC-6.2\n(Slika 3.5)" as G6
    usecase "Administracija\nUC-7.1 – UC-7.4\n(Slika 3.5)" as G7
}

' Student može sve što i posjetitelj
Student -|> Visitor

Visitor --> G2
Student --> G1
Student --> G3
' Partner i administrator crtaju se s desne strane granice sustava
G1 <-- Partner
G4 <-- Partner
G5 <-- Partner
G6 <-- Partner
G1 <-- Admin
G7 <-- Admin
@enduml
