# Supabase → Project Settings → API. Obje vrijednosti su javne (vidljive pregledniku).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-ili-anon-kljuc>
# Google Cloud → Google Auth Platform → Clients → UniDeal. Javna vrijednost; isti Client ID upisan je i u Supabaseu.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# Resend → API Keys (Sending access, domena unideal.site). TAJNA vrijednost: samo ovdje i u Vercelu, nikad u repozitoriju.
# Bez ključa aplikacija radi, a e-mailovi se samo ispisuju u konzolu poslužitelja (#14).
RESEND_API_KEY=
